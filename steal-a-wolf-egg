/* =================== CẬP NHẬT: CHẠY TRỐN =================== */
function stumble(){
  pl.stun=.6;pl.inv=1.2;pl.vx=-60;pl.vy=Math.min(pl.vy,-280);pl.on=false;shake=13;run.stumbles++;
  SFX.hit();burst(pl.x,pl.y-30,16,'#ffb347',260,.6,3,700);floatText(pl.x,pl.y-90,'Ái!','#ff6b6b');
}
function updChase(dt){
  const cfg=cfgCur,sh=curShoe(),maxV=BASE_SPEED+sh.bonus;
  run.t+=dt;run.banner=Math.max(0,run.banner-dt);
  if(pl.stun>0)pl.stun-=dt;if(pl.inv>0)pl.inv-=dt;
  pl.jbuf=Math.max(0,pl.jbuf-dt);
  if(pl.falling){
    pl.vy+=GRAV*dt;pl.y+=pl.vy*dt;pl.x+=pl.vx*dt*.3;pl.vx*=.97;
    if(pl.y>GROUND+170){
      const p=pl.fallPit;pl.x=p.x-45;pl.y=GROUND;pl.vy=0;pl.vx=0;pl.falling=false;pl.on=true;
      pl.stun=.7;pl.inv=1.8;shake=8;run.stumbles++;floatText(pl.x,pl.y-90,'Rơi hố!','#ff6b6b');
    }
  }else{
    const mul=pl.stun>0?.4:1;let target=0;
    if(keys.right)target=maxV*mul;else if(keys.left)target=-maxV*.4*mul;
    pl.vx+=(target-pl.vx)*Math.min(1,dt*(target?9:6));
    pl.coyote=pl.on?.09:Math.max(0,pl.coyote-dt);
    if(pl.jbuf>0&&pl.coyote>0){pl.vy=-JUMP;pl.on=false;pl.coyote=0;pl.jbuf=0;SFX.jump();burst(pl.x,pl.y,6,'#d8c9a6',110,.35,3,200);}
    pl.vy+=GRAV*dt;pl.y+=pl.vy*dt;pl.x+=pl.vx*dt;pl.x=Math.max(60,pl.x);
    const pit=pitAt(pl.x);
    if(pl.y>=GROUND){
      if(pit){pl.falling=true;pl.fallPit=pit;pl.on=false;SFX.fall();}
      else{if(!pl.on&&pl.vy>200){SFX.land();burst(pl.x,pl.y,6,'#d8c9a6',100,.3,3,200);}pl.y=GROUND;pl.vy=0;pl.on=true;}
    }else pl.on=false;
    if(pl.on&&Math.abs(pl.vx)>40){
      pl.anim+=dt*Math.min(Math.abs(pl.vx),650)/22;
      const sp=Math.floor(pl.anim/Math.PI);if(sp!==pl.stepPh){pl.stepPh=sp;SFX.step();}
      pl.dust-=dt;if(pl.dust<=0){pl.dust=.06;addP(pl.x-8,pl.y-2,-40-Math.random()*40,-20-Math.random()*30,.4,3+Math.random()*3,'rgba(220,200,160,.7)',0);}
    }
    if(sh.glow&&Math.abs(pl.vx)>60){pl.trail-=dt;if(pl.trail<=0){pl.trail=.03;addP(pl.x-10,pl.y-5+Math.random()*6,-60,-10,.5,3,sh.glow,0,true);}}
    if(sh.id==='kc'&&Math.random()<.2)addP(pl.x+(Math.random()-.5)*20,pl.y-Math.random()*8,0,-30,.5,2,'#fff',0,true);
    if(!pl.falling&&pl.inv<=0){
      const bx0=pl.x-12,bx1=pl.x+12,by0=pl.y-58,by1=pl.y-2;
      for(const o of LV.obs){
        if(o.type==='pit')continue;
        const r=hitbox(o);
        if(bx1>r.x0&&bx0<r.x1&&by1>r.y0&&by0<r.y1){stumble();break;}
      }
    }
  }
  if(keys.right)pl.face=1;else if(keys.left)pl.face=-1;
  // vật cản di chuyển
  for(const o of LV.obs){if(o.type==='boulder'){if(!o.active&&o.x-pl.x<650)o.active=true;if(o.active){o.x-=o.vx*dt;o.rot-=o.vx*dt/o.r;}}}
  // xu
  for(const c of LV.coins){
    if(c.got)continue;
    if(Math.abs(c.x-pl.x)<26&&Math.abs(c.y-(pl.y-30))<40){c.got=true;run.coins++;SFX.coin();burst(c.x,c.y,6,'#ffd166',120,.4,2.5,0);floatText(c.x,c.y-14,'+1','#ffd166');}
  }
  // sói
  wolf.vtimer-=dt;
  if(wolf.vtimer<=0){
    wolf.vtimer=.7+Math.random()*1.6;
    wolf.vt=cfg.wolf*(WOLF_MIN+Math.random()*(WOLF_MAX-WOLF_MIN));
    if(wolf.vt>cfg.wolf*1.25){SFX.growl();floatText(wolf.x+90,GROUND-150,'Sói tăng tốc!','#ff6b6b');}
  }
  wolf.v+=(wolf.vt-wolf.v)*Math.min(1,dt*3);
  wolf.burst=wolf.v>cfg.wolf*1.2;
  if(wolf.burst&&Math.random()<.6)addP(wolf.x-70,GROUND-30-Math.random()*60,-120,0,.35,3,'#ff7a7a',0,true);
  wolf.x+=wolf.v*dt;wolf.anim+=dt*(7+Math.min(wolf.v,700)/45);
  let hop=0;
  for(const o of LV.obs){
    const ox=o.type==='boulder'?o.x-o.r:o.x,hh=o.type==='pit'?40:o.h+34;
    if(wolf.x>ox-90&&wolf.x<ox+o.w+10){const t=(wolf.x-(ox-90))/(o.w+100);hop=Math.max(hop,Math.sin(t*Math.PI)*hh);}
  }
  wolf.hop=hop;
  const gap=pl.x-(wolf.x+50);
  if(gap<cfg.wolfAvg*1.1){wolf.growl-=dt;if(wolf.growl<=0){SFX.growl();wolf.growl=1.5;}}
  if(gap<=6&&!pl.falling){lose();return;}
  if(pl.x>=cfg.length-20){win();return;}
  const lead=lerp(300,130,clamp((Math.abs(pl.vx)-240)/700,0,1)),target=Math.max(0,pl.x-lead);cam+=(target-cam)*Math.min(1,dt*8);
}

