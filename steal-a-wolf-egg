<!DOCTYPE html>
 <html lang="vi">
  <head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Steal a Wolf Egg</title>
<style>
:root{--line:#3a2b5e;--gold:#ffd166;--pink:#ff5d8f;--text:#f3ecff;--mut:#a99cc9;--ok:#5ee6a0}
*{box-sizing:border-box;margin:0;padding:0}
body{background:radial-gradient(circle at 50% 0,#2a1b4d,#0b0716 70%);color:var(--text);font-family:"Segoe UI",system-ui,sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center;user-select:none;-webkit-user-select:none}
#stage{position:relative;width:min(100vw,960px,calc(100vh*16/9));aspect-ratio:16/9;border-radius:14px;overflow:hidden;box-shadow:0 0 60px #7a3bff55;background:#000}
canvas{width:100%;height:100%;display:block;cursor:crosshair}
.ov{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;gap:9px;background:rgba(10,6,22,.84);backdrop-filter:blur(3px);padding:14px;overflow:auto;text-align:center}
.ov.show{display:flex}
h1{font-size:2.1rem;background:linear-gradient(90deg,#ffd166,#ff5d8f);-webkit-background-clip:text;background-clip:text;color:transparent;letter-spacing:.5px}
h2{font-size:1.5rem;color:var(--gold)}
.sub{color:var(--mut);font-size:.9rem;max-width:520px;line-height:1.5}
.stat{font-size:.95rem;color:var(--text);background:#20153b;border:1px solid var(--line);border-radius:10px;padding:6px 14px}
.btn{background:#2c2050;border:1px solid var(--line);color:var(--text);padding:10px 20px;border-radius:12px;font-size:15px;cursor:pointer;min-width:230px;transition:.15s;font-family:inherit}
.btn:hover{background:#3a2b6b;transform:translateY(-1px)}
.btn.primary{background:linear-gradient(90deg,#ff5d8f,#ff9d4d);color:#2a0f1a;font-weight:700;border:none;box-shadow:0 0 22px -4px #ff5d8f}
.btn.small{min-width:0;padding:7px 14px;font-size:13px}
.btn:disabled{opacity:.4;cursor:not-allowed;transform:none}
.row{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
#lvGrid{display:grid;grid-template-columns:repeat(10,1fr);gap:6px;width:100%;max-width:700px}
.lv{background:#2c2050;border:1px solid var(--line);color:var(--text);border-radius:8px;padding:8px 0;font-size:13px;cursor:pointer;font-family:inherit}
.lv:hover:not(:disabled){background:#4a3590}
.lv.done{border-color:var(--gold);color:var(--gold)}
.lv.cur{background:linear-gradient(90deg,#ff5d8f,#ff9d4d);color:#2a0f1a;font-weight:700;border:none}
.lv:disabled{opacity:.28;cursor:not-allowed}
#shopList{display:grid;grid-template-columns:1fr 1fr;gap:8px;width:100%;max-width:760px}
.card{display:flex;gap:10px;align-items:center;background:#20153b;border:1px solid var(--line);border-radius:12px;padding:8px 10px;text-align:left}
.card.on{border-color:var(--ok);box-shadow:0 0 14px -4px var(--ok)}
.card canvas{width:84px;height:52px;flex:none;cursor:default;background:#150e29;border-radius:8px}
.card .info{flex:1;min-width:0;font-size:.82rem}
.card .info b{display:block;font-size:.92rem}
.bar{height:6px;background:#352858;border-radius:4px;margin:4px 0;overflow:hidden}
.bar i{display:block;height:100%;background:linear-gradient(90deg,#5ee6a0,#ffd166,#ff5d8f)}
.card .btn{min-width:84px;padding:6px 8px;font-size:12px}
.price{color:var(--gold);font-weight:700}
#pauseBtn{position:absolute;right:12px;bottom:12px;width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:rgba(28,18,52,.85);color:#fff;font-size:18px;cursor:pointer;display:none;z-index:5;transition:.15s}
#pauseBtn:hover{background:#4a3590;transform:scale(1.08)}
#pauseBtn.on{display:block}
@media(max-width:700px){#shopList{grid-template-columns:1fr}h1{font-size:1.4rem}}
</style>
</head>
<body>
<div id="stage">
  <canvas id="c" width="960" height="540"></canvas>
  <button id="pauseBtn" tabindex="-1" title="Tạm dừng (Esc / P)" aria-label="Tạm dừng">⏸</button>

  <div class="ov show" id="menu">
    <h1>🥚 Steal a Wolf Egg</h1>
    <p class="sub">Trộm trứng sói rồi chạy thoát khỏi con sói đang đuổi theo. Vượt chướng ngại vật, nhặt xu, mua giày xịn để chạy nhanh hơn. 70 màn, sói càng lúc càng nhanh!</p>
    <div class="stat">🪙 <b id="mCoins">0</b> &nbsp;·&nbsp; Màn đã mở: <b id="mUnl">1</b>/70 &nbsp;·&nbsp; 👟 <b id="mShoe"></b></div>
    <button class="btn primary" id="bPlay">▶ Chơi (Màn <span id="mLv">1</span>)</button>
    <button class="btn" id="bLevels">🗺 Chọn màn</button>
    <button class="btn" id="bShop">👟 Cửa hàng giày</button>
    <button class="btn" id="bHelp">❓ Hướng dẫn</button>
    <button class="btn small" id="bMute">🔊 Âm thanh: Bật</button>
  </div>

  <div class="ov" id="levels">
    <h2>Chọn màn</h2>
    <div id="lvGrid"></div>
    <p class="sub">Phải thắng màn trước mới mở được màn sau. Có thể chơi lại màn cũ để kiếm xu.</p>
    <button class="btn" id="lvBack">⬅ Quay lại</button>
  </div>

  <div class="ov" id="shop">
    <h2>👟 Cửa hàng giày</h2>
    <div class="stat">🪙 <b id="sCoins">0</b> &nbsp;·&nbsp; <span id="sWolf"></span></div>
    <div id="shopList"></div>
    <button class="btn" id="shopBack">⬅ Quay lại</button>
  </div>

  <div class="ov" id="help">
    <h2>Hướng dẫn</h2>
    <p class="sub" style="font-size:1rem">
      <b>1. Trộm trứng:</b> click liên tục vào quả trứng sói. Mỗi màn càng về sau càng cần click nhiều.<br>
      <b>2. Chạy trốn:</b> giữ <b>→ / D</b> để chạy, <b>← / A</b> để lùi, <b>↑ / W</b> (hoặc Space) để nhảy.<br>
      <b>3. Vượt chướng ngại:</b> đá, bụi gai, khúc gỗ, hố sâu, bẫy gai, lửa, tảng đá lăn. Vấp phải sẽ bị chậm lại, rơi hố sẽ mất nhiều thời gian.<br>
      <b>4. Thoát:</b> chạy tới hang an toàn trước khi sói bắt được bạn.<br>
      <b>5. Giày:</b> nhặt xu và thắng màn để lấy xu, mua giày tốt hơn để chạy nhanh hơn sói.<br>
      <b>Phím khác:</b> Esc / P tạm dừng, M bật/tắt âm.
    </p>
    <button class="btn" id="helpBack">⬅ Quay lại</button>
  </div>

  <div class="ov" id="pause">
    <h2>⏸ Tạm dừng</h2>
    <button class="btn primary" id="pResume">▶ Tiếp tục</button>
    <button class="btn" id="pRetry">🔄 Chơi lại màn này</button>
    <button class="btn" id="pMenu">🏠 Về trang chủ (Home)</button>
  </div>

  <div class="ov" id="result">
    <h2 id="rTitle"></h2>
    <p class="sub" id="rBody" style="font-size:1rem"></p>
    <button class="btn primary" id="rNext">➡ Màn tiếp theo</button>
    <button class="btn" id="rRetry">🔄 Chơi lại</button>
    <button class="btn" id="rShop">👟 Cửa hàng giày</button>
    <button class="btn" id="rMenu">🏠 Menu</button>
  </div>
</div>

<script>
'use strict';
/* =================== HẰNG SỐ & TIỆN ÍCH =================== */
const WOLF_MIN=.78,WOLF_MAX=1.40,WOLF_MEAN=(WOLF_MIN+WOLF_MAX)/2;
const W=960,H=540,GROUND=430,BASE_SPEED=240,JUMP=820,GRAV=2600,MAX_LEVEL=70;
const cv=document.getElementById('c'),ctx=cv.getContext('2d');
const $=id=>document.getElementById(id);
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const lerp=(a,b,t)=>a+(b-a)*t;
const easeOut=t=>1-Math.pow(1-t,3);
const hash=n=>{const s=Math.sin(n*127.1+311.7)*43758.5453;return s-Math.floor(s);};
function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296;};}
function rr(c,x,y,w,h,r){c.beginPath();c.moveTo(x+r,y);c.arcTo(x+w,y,x+w,y+h,r);c.arcTo(x+w,y+h,x,y+h,r);c.arcTo(x,y+h,x,y,r);c.arcTo(x,y,x+w,y,r);c.closePath();}
function text(s,x,y,size,col,align,stroke){ctx.font='700 '+size+'px "Segoe UI",system-ui,sans-serif';ctx.textAlign=align||'left';ctx.textBaseline='middle';if(stroke){ctx.lineWidth=4;ctx.strokeStyle=stroke;ctx.lineJoin='round';ctx.strokeText(s,x,y);}ctx.fillStyle=col;ctx.fillText(s,x,y);}
const fmt=n=>Math.floor(n).toLocaleString('vi-VN');

/* =================== LƯU TRỮ =================== */
const SAVE_KEY='steal-wolf-egg-v1';
let save={coins:0,owned:['none'],shoe:'none',unlocked:1,done:{}};
function loadSave(){try{const r=localStorage.getItem(SAVE_KEY);if(r){const s=JSON.parse(r);if(s&&typeof s==='object')save=Object.assign(save,s);}}catch(e){}
  if(!Array.isArray(save.owned)||!save.owned.includes('none'))save.owned=['none',...(Array.isArray(save.owned)?save.owned:[])];
  if(!save.done||typeof save.done!=='object')save.done={};
  save.unlocked=clamp(save.unlocked|0||1,1,MAX_LEVEL);
  if(!save.owned.includes(save.shoe))save.shoe='none';
  save.coins=Math.max(0,save.coins|0);}
function persist(){try{localStorage.setItem(SAVE_KEY,JSON.stringify(save));}catch(e){}}

/* =================== GIÀY =================== */
const SHOES=[
 {id:'none',name:'Chân trần',bonus:0,price:0,c1:'#e6b98a',c2:'#c98f5f'},
 {id:'da',name:'Giày da',bonus:115,price:1200,c1:'#9a6030',c2:'#5e3b1a'},
 {id:'sat',name:'Giày sắt',bonus:245,price:4800,c1:'#aab3bd',c2:'#5d6670'},
 {id:'dong',name:'Giày đồng',bonus:385,price:12000,c1:'#e0914f',c2:'#a35a24'},
 {id:'kc',name:'Giày kim cương',bonus:530,price:19000,c1:'#8df5ff',c2:'#2bb7d6',glow:'#7df3ff'},
 {id:'hdt',name:'Giày hắc diện thạch',bonus:695,price:28000,c1:'#2c2c40',c2:'#0b0b14',glow:'#9b5cff'},
 {id:'quy',name:'Giày ác quỷ',bonus:875,price:36000,c1:'#c1121f',c2:'#6b0b12',glow:'#ff3b30'},
 {id:'tt',name:'Giày thiên thần',bonus:1080,price:48000,c1:'#fff6c2',c2:'#ffd166',glow:'#fff2a6'},
];
const curShoe=()=>SHOES.find(s=>s.id===save.shoe)||SHOES[0];
const playerSpeed=()=>BASE_SPEED+curShoe().bonus;

function drawShoe(c,x,y,s,shoe,t){
  c.save();c.translate(x,y);c.scale(s,s);
  if(shoe.glow){c.shadowColor=shoe.glow;c.shadowBlur=12;}
  c.fillStyle=shoe.c2;rr(c,-8,5,25,4,2);c.fill();
  c.fillStyle=shoe.c1;
  c.beginPath();c.moveTo(-7,-8);c.lineTo(3,-8);c.lineTo(5,0);c.quadraticCurveTo(16,1,17,6);c.lineTo(17,6);c.lineTo(17,7);c.lineTo(-8,7);c.closePath();c.fill();
  c.shadowBlur=0;
  c.strokeStyle='rgba(255,255,255,.45)';c.lineWidth=1.2;c.beginPath();c.moveTo(-5,-5);c.lineTo(2,-5);c.stroke();
  if(shoe.id==='sat'||shoe.id==='dong'){c.fillStyle='rgba(0,0,0,.25)';for(let i=0;i<3;i++){c.beginPath();c.arc(-3+i*6,2,1.1,0,7);c.fill();}}
  if(shoe.id==='kc'){c.fillStyle='#fff';const k=.6+.4*Math.sin((t||0)*6);c.globalAlpha=k;c.beginPath();c.moveTo(8,-2);c.lineTo(10,1);c.lineTo(8,4);c.lineTo(6,1);c.closePath();c.fill();c.globalAlpha=1;}
  if(shoe.id==='hdt'){c.strokeStyle='#9b5cff';c.lineWidth=1.6;c.beginPath();c.moveTo(-6,2);c.lineTo(14,2);c.stroke();}
  if(shoe.id==='quy'){c.fillStyle='#1a0306';c.beginPath();c.moveTo(-8,-8);c.lineTo(-12,-15);c.lineTo(-4,-8);c.closePath();c.fill();c.beginPath();c.moveTo(0,-8);c.lineTo(-2,-14);c.lineTo(3,-8);c.closePath();c.fill();}
  if(shoe.id==='tt'){c.fillStyle='#fff';c.shadowColor='#fff2a6';c.shadowBlur=8;c.beginPath();c.ellipse(-9,-4,9,3.4,-0.5,0,7);c.fill();c.beginPath();c.ellipse(-9,0,7,2.6,-0.2,0,7);c.fill();}
  c.restore();
}

/* =================== ÂM THANH =================== */
let AC=null,master=null,muted=false;
try{muted=localStorage.getItem('swe-muted')==='1';}catch(e){}
function initAudio(){
  if(!AC){try{AC=new (window.AudioContext||window.webkitAudioContext)();master=AC.createGain();master.gain.value=muted?0:.9;master.connect(AC.destination);}catch(e){AC=null;}}
  if(AC&&AC.state==='suspended')AC.resume();
}
function tone(f,d,type,v,delay,f2){
  if(!AC)return;type=type||'sine';v=v==null?.12:v;delay=delay||0;
  const o=AC.createOscillator(),g=AC.createGain(),t=AC.currentTime+delay;
  o.type=type;o.frequency.setValueAtTime(f,t);if(f2)o.frequency.exponentialRampToValueAtTime(f2,t+d);
  g.gain.setValueAtTime(v,t);g.gain.exponentialRampToValueAtTime(.0008,t+d);
  o.connect(g);g.connect(master);o.start(t);o.stop(t+d+.03);
}
function noise(d,v,delay,freq,ftype){
  if(!AC)return;v=v==null?.15:v;delay=delay||0;
  const n=Math.max(1,Math.floor(AC.sampleRate*d)),b=AC.createBuffer(1,n,AC.sampleRate),a=b.getChannelData(0);
  for(let i=0;i<n;i++)a[i]=(Math.random()*2-1)*Math.pow(1-i/n,2);
  const s=AC.createBufferSource();s.buffer=b;const g=AC.createGain();g.gain.value=v;
  if(freq){const f=AC.createBiquadFilter();f.type=ftype||'lowpass';f.frequency.value=freq;s.connect(f);f.connect(g);}else s.connect(g);
  g.connect(master);s.start(AC.currentTime+delay);
}
const SFX={
  ui:()=>tone(620,.05,'square',.04),
  click:()=>{noise(.09,.28,0,500);tone(190,.14,'triangle',.16,0,90);},
  miss:()=>noise(.05,.08,0,300),
  crack:()=>{noise(.16,.3,0,2600,'highpass');tone(900,.05,'square',.04);},
  grab:()=>{tone(520,.09,'triangle',.12);tone(780,.09,'triangle',.12,.08);tone(1040,.14,'triangle',.12,.16);},
  howl:()=>{tone(240,.55,'sawtooth',.1,0,560);tone(560,1,'sawtooth',.1,.5,300);tone(250,.55,'sine',.12,0,560);tone(560,1,'sine',.12,.5,300);},
  jump:()=>tone(320,.18,'square',.06,0,740),
  land:()=>noise(.07,.1,0,500),
  step:()=>noise(.035,.05,0,1000),
  hit:()=>{noise(.26,.32,0,320);tone(130,.26,'sawtooth',.14,0,48);},
  fall:()=>tone(520,.55,'sine',.12,0,70),
  coin:()=>{tone(988,.07,'square',.05);tone(1319,.12,'square',.05,.06);},
  growl:()=>{tone(78,.35,'sawtooth',.09,0,52);noise(.3,.05,0,400);},
  win:()=>{[523,659,784,1047,1319].forEach((f,i)=>tone(f,.2,'triangle',.12,i*.1));},
  lose:()=>{tone(500,.18,'sawtooth',.12,0,300);tone(300,.3,'sawtooth',.12,.17,110);noise(.4,.2,.1,400);},
  buy:()=>{tone(784,.08,'square',.06);tone(1047,.08,'square',.06,.07);tone(1568,.16,'square',.06,.14);},
  err:()=>tone(160,.16,'square',.08),
};
let musicOn=false,musicStep=0,musicNext=0,musicTimer=null,musicBpm=130;
const BASSF=[55,55,65.4,55,49,49,58.3,49];
function musicTick(){
  if(!AC||!musicOn)return;
  const spb=60/musicBpm/4;
  while(musicNext<AC.currentTime+.25){
    const s=musicStep%16,t=Math.max(0,musicNext-AC.currentTime);
    if(s%4===0)tone(120,.13,'sine',.2,t,38);
    if(s%2===1)noise(.03,.04,t,6000,'highpass');
    if(s%2===0)tone(BASSF[Math.floor(s/2)%8]*2,.17,'sawtooth',.04,t);
    if(s===6||s===14)tone(BASSF[Math.floor(s/2)%8]*8,.08,'square',.025,t);
    musicStep++;musicNext+=spb;
  }
}
function startMusic(bpm){
  stopMusic();if(!AC)return;musicBpm=bpm;musicOn=true;musicStep=0;musicNext=AC.currentTime+.05;
  musicTimer=setInterval(musicTick,80);
}
function stopMusic(){musicOn=false;if(musicTimer){clearInterval(musicTimer);musicTimer=null;}}
function setMuted(m){muted=m;if(master)master.gain.value=m?0:.9;try{localStorage.setItem('swe-muted',m?'1':'0');}catch(e){}$('bMute').textContent=m?'🔇 Âm thanh: Tắt':'🔊 Âm thanh: Bật';}

/* =================== GIAO DIỆN (overlay) =================== */
const OVS=['menu','levels','shop','help','pause','result'];
function show(id){OVS.forEach(o=>$(o).classList.toggle('show',o===id));}
function hideAll(){OVS.forEach(o=>$(o).classList.remove('show'));}
function refreshMenu(){
  $('mCoins').textContent=fmt(save.coins);$('mUnl').textContent=save.unlocked;
  $('mShoe').textContent=curShoe().name;$('mLv').textContent=save.unlocked;
}
function buildLevels(){
  const g=$('lvGrid');g.innerHTML='';
  for(let L=1;L<=MAX_LEVEL;L++){
    const b=document.createElement('button');b.className='lv'+(save.done[L]?' done':'')+(L===save.unlocked?' cur':'');
    b.textContent=save.done[L]?L+'★':L;b.disabled=L>save.unlocked;
    b.title='Sói chạy TB ~'+Math.round(levelCfg(L).wolfAvg);
    b.addEventListener('click',()=>{SFX.ui();beginLevel(L);});g.appendChild(b);
  }
}
let shopFrom='menu';
function renderShop(){
  $('sCoins').textContent=fmt(save.coins);
  $('sWolf').textContent='Sói màn '+save.unlocked+' chạy TB ~'+Math.round(levelCfg(save.unlocked).wolfAvg)+' · Bạn chạy '+playerSpeed();
  const list=$('shopList');list.innerHTML='';
  const maxSp=BASE_SPEED+SHOES[SHOES.length-1].bonus;
  SHOES.forEach(s=>{
    const owned=save.owned.includes(s.id),eq=save.shoe===s.id;
    const card=document.createElement('div');card.className='card'+(eq?' on':'');
    const ic=document.createElement('canvas');ic.width=168;ic.height=104;
    const c=ic.getContext('2d');c.fillStyle='#150e29';c.fillRect(0,0,168,104);
    c.save();c.scale(2,2);if(s.glow){const g=c.createRadialGradient(42,26,2,42,26,34);g.addColorStop(0,s.glow+'66');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,84,52);}
    drawShoe(c,30,24,2.1,s,0.5);c.restore();
    const info=document.createElement('div');info.className='info';
    const sp=BASE_SPEED+s.bonus;
    info.innerHTML='<b>'+s.name+'</b>Tốc độ: '+sp+(s.bonus?' (+'+s.bonus+')':'')+'<div class="bar"><i style="width:'+Math.round(sp/maxSp*100)+'%"></i></div>'+(owned?'<span style="color:var(--ok)">Đã sở hữu</span>':'<span class="price">🪙 '+fmt(s.price)+'</span>');
    const btn=document.createElement('button');btn.className='btn';
    if(eq){btn.textContent='Đang mang';btn.disabled=true;}
    else if(owned){btn.textContent='Trang bị';btn.addEventListener('click',()=>{save.shoe=s.id;persist();SFX.ui();renderShop();refreshMenu();});}
    else{btn.textContent='Mua';if(save.coins<s.price)btn.disabled=true;
      btn.addEventListener('click',()=>{if(save.coins>=s.price){save.coins-=s.price;save.owned.push(s.id);save.shoe=s.id;persist();SFX.buy();renderShop();refreshMenu();}else SFX.err();});}
    card.append(ic,info,btn);list.appendChild(card);
  });
}

/* =================== CẤU HÌNH MÀN =================== */
const WOLF_BASE=(()=>{const r=mulberry32(20261016),a=[0,215];for(let L=2;L<=MAX_LEVEL;L++)a[L]=a[L-1]+8+Math.floor(r()*13);return a;})(); // mỗi màn sói tăng 8-20 sức chạy
function levelCfg(L){
  const wolf=WOLF_BASE[L],wolfAvg=wolf*WOLF_MEAN,ref=wolfAvg*1.02,tg=lerp(1.75,.42,(L-1)/(MAX_LEVEL-1));
  const gapMin=Math.max(200,ref*tg);
  return{length:Math.round(Math.max(3000,wolfAvg*12.6)),wolf,wolfAvg,clicks:3+Math.floor((L-1)/10),gapMin,gapMax:gapMin+wolfAvg*1.17,reward:400+L*90,coinVal:6+Math.floor(L*1.1)};
}
