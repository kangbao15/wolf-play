function makeObs(type,x,rnd,L){
  switch(type){
    case'rock':return{type,x,w:44+rnd()*14,h:38+rnd()*10};
    case'bush':return{type,x,w:64+rnd()*20,h:32+rnd()*8};
    case'log':return{type,x,w:90+rnd()*20,h:48+rnd()*8};
    case'pit':return{type,x,w:72+rnd()*30+Math.min(L,50)*.5,h:0};
    case'spike':return{type,x,w:90+rnd()*20,h:38};
    case'fire':return{type,x,w:52,h:58};
    case'boulder':{const r=26+rnd()*8;return{type,x:x+r,w:r*2,h:r*2,r,vx:100+L*4,active:false,rot:0};}
  }
}
function buildLevel(L){
  const cfg=levelCfg(L),rnd=mulberry32(L*7919+13),obs=[],coins=[];
  const pool=[['rock',1],['bush',3],['log',5],['pit',8],['boulder',14],['spike',22],['fire',35]];
  const avail=pool.filter(p=>L>=p[1]).map(p=>p[0]);
  let x=900,last=null;
  while(x<cfg.length-650){
    let t=avail[Math.floor(rnd()*avail.length)];
    if(t===last&&avail.length>1&&rnd()<.6)t=avail[Math.floor(rnd()*avail.length)];
    last=t;
    const o=makeObs(t,x,rnd,L);obs.push(o);
    const ox=t==='boulder'?o.x-o.r:o.x;
    if(t!=='boulder'){
      const top=GROUND-(t==='pit'?60:o.h)-28;
      for(let i=0;i<4;i++)coins.push({x:ox+o.w*(i/3),y:top-Math.sin(i/3*Math.PI)*36,got:false});
    }
    let end=ox+o.w;
    if(L>=12&&['rock','bush','log'].includes(t)&&rnd()<Math.min(.4,L/150)){
      const t2=['rock','bush','log'][Math.floor(rnd()*3)],o2=makeObs(t2,end+130+rnd()*40,rnd,L);
      obs.push(o2);end=o2.x+o2.w;
    }
    const gap=cfg.gapMin+rnd()*(cfg.gapMax-cfg.gapMin);
    if(gap>260&&rnd()<.5)for(let i=0;i<4;i++)coins.push({x:end+70+i*36,y:GROUND-26,got:false});
    x=end+gap;
  }
  return{obs,coins};
}
const hitbox=o=>o.type==='boulder'?{x0:o.x-o.r*.8,x1:o.x+o.r*.8,y0:GROUND-o.r*1.8,y1:GROUND}:{x0:o.x+5,x1:o.x+o.w-5,y0:GROUND-o.h+5,y1:GROUND};
function pitAt(x){for(const o of LV.obs){if(o.type==='pit'&&x>o.x+10&&x<o.x+o.w-10)return o;}return null;}

