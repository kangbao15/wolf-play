function addP(x,y,vx,vy,life,s,c,g,glow){parts.push({x,y,vx,vy,life,max:life,s,c,g:g||0,glow:!!glow});}
function burst(x,y,n,c,sp,life,s,g){for(let i=0;i<n;i++){const a=Math.random()*Math.PI*2,v=(sp||200)*(.3+Math.random()*.7);addP(x,y,Math.cos(a)*v,Math.sin(a)*v,(life||.6)*(.6+Math.random()*.6),(s||3)*(.6+Math.random()*.8),c,g==null?600:g);}}
function floatText(x,y,s,c){floats.push({x,y,s,c,life:1});}
function updFx(dt){
  for(const p of parts){p.life-=dt;p.vy+=p.g*dt;p.x+=p.vx*dt;p.y+=p.vy*dt;}
  parts=parts.filter(p=>p.life>0);
  for(const f of floats){f.life-=dt;f.y-=45*dt;}
  floats=floats.filter(f=>f.life>0);
  for(const c of confs){c.life-=dt;c.x+=c.vx*dt;c.y+=c.vy*dt;c.vy+=380*dt;c.vx*=.995;c.r+=c.vr*dt;}
  confs=confs.filter(c=>c.life>0&&c.y<H+30);
  for(const a of amb){
    if(T.amb==='snow'){a.y+=(40+a.s*18)*dt;a.x+=Math.sin(tNow+a.ph)*18*dt;if(a.y>H){a.y=-5;a.x=Math.random()*W;}}
    else if(T.amb==='fly'){a.x+=Math.sin(tNow*.8+a.ph)*30*dt;a.y+=Math.cos(tNow*.7+a.ph)*24*dt;}
    else{a.y-=(25+a.s*14)*dt;a.x+=Math.sin(tNow+a.ph)*14*dt;if(a.y<-5){a.y=H+5;a.x=Math.random()*W;}}
  }
  if(shake>.3)shake*=Math.pow(.02,dt);else shake=0;
}
function spawnConfetti(){for(let i=0;i<150;i++)confs.push({x:Math.random()*W,y:-20-Math.random()*200,vx:(Math.random()-.5)*160,vy:60+Math.random()*160,r:Math.random()*6,vr:(Math.random()-.5)*10,c:['#ffd166','#ff5d8f','#5ee6a0','#7df3ff','#c39bff'][i%5],life:6,s:5+Math.random()*5});}

