/* =================== VẼ: NỀN, ĐẤT =================== */
function drawPine(x,base,h,col,col2,snow){
  ctx.fillStyle='#3b2a1e';ctx.fillRect(x-3,base-h*.18,6,h*.18);
  for(let i=0;i<3;i++){
    const y=base-h*.12-i*h*.27,w=h*(.42-i*.09);
    ctx.fillStyle=i%2?col2:col;ctx.beginPath();ctx.moveTo(x-w,y);ctx.lineTo(x,y-h*.42);ctx.lineTo(x+w,y);ctx.closePath();ctx.fill();
    if(snow){ctx.fillStyle='#fff';ctx.beginPath();ctx.moveTo(x-w*.45,y-h*.18);ctx.lineTo(x,y-h*.42);ctx.lineTo(x+w*.45,y-h*.18);ctx.closePath();ctx.fill();}
  }
}
function drawCactus(x,base,h,col){
  ctx.fillStyle=col;rr(ctx,x-6,base-h,12,h,6);ctx.fill();
  rr(ctx,x-22,base-h*.65,10,h*.35,5);ctx.fill();rr(ctx,x-22,base-h*.65,18,8,4);ctx.fill();
  rr(ctx,x+12,base-h*.8,10,h*.4,5);ctx.fill();rr(ctx,x+4,base-h*.5,18,8,4);ctx.fill();
}
function treeLayer(c,f,sp,hmin,hmax,col,col2,off){
  const i0=Math.floor(c*f/sp)-1,i1=i0+Math.ceil(W/sp)+3;
  for(let i=i0;i<=i1;i++){
    const r=hash(i*3+off),x=i*sp-c*f+r*sp*.6,h=hmin+hash(i*7+off+5)*(hmax-hmin);
    if(T.cactus)drawCactus(x,GROUND+4,h*.6,col2);else drawPine(x,GROUND+4,h,col,col2,T.snow);
  }
}
function drawBG(c){
  const g=ctx.createLinearGradient(0,0,0,GROUND);g.addColorStop(0,T.sky[0]);g.addColorStop(1,T.sky[1]);
  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  if(T.stars)for(const s of stars){ctx.globalAlpha=.4+.5*Math.sin(tNow*2+s.ph);ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,7);ctx.fill();}
  ctx.globalAlpha=1;
  ctx.save();ctx.shadowColor=T.sun;ctx.shadowBlur=50;ctx.fillStyle=T.sun;ctx.beginPath();ctx.arc(780-c*.02,105,44,0,7);ctx.fill();ctx.restore();
  ctx.fillStyle=T.far;ctx.beginPath();ctx.moveTo(0,H);
  for(let x=0;x<=W;x+=8){const xx=x+c*.15;ctx.lineTo(x,GROUND-70-(Math.sin(xx*.006)*30+Math.sin(xx*.013+2)*18));}
  ctx.lineTo(W,H);ctx.closePath();ctx.fill();
  treeLayer(c,.3,120,90,150,T.far,T.tree,1);
  treeLayer(c,.55,95,110,190,T.tree,T.tree2,2);
  if(T.fog){const f=ctx.createLinearGradient(0,GROUND-120,0,GROUND);f.addColorStop(0,'rgba(160,220,180,0)');f.addColorStop(1,'rgba(160,220,180,.22)');ctx.fillStyle=f;ctx.fillRect(0,GROUND-120,W,120);}
}
function drawGround(c,pits){
  const x0=c-60,x1=c+W+60;let segs=[[x0,x1]];
  for(const p of pits){const ns=[];for(const s of segs){if(p.x+p.w<=s[0]||p.x>=s[1]){ns.push(s);continue;}if(p.x>s[0])ns.push([s[0],p.x]);if(p.x+p.w<s[1])ns.push([p.x+p.w,s[1]]);}segs=ns;}
  for(const p of pits){
