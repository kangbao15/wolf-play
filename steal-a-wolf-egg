  text('🪙 '+fmt(save.coins)+'  +'+run.coins,W-20,26,18,'#ffd166','right','rgba(0,0,0,.6)');
  text('👟 '+curShoe().name+' · '+playerSpeed(),W-20,50,13,'#d8cff5','right','rgba(0,0,0,.6)');
  text('🐺 '+Math.round(wolf.v)+(wolf.burst?' 💨':'')+' (TB '+Math.round(cfg.wolfAvg)+')',W-20,70,13,wolf.burst?'#ff4d4d':'#ff8a8a','right','rgba(0,0,0,.6)');
  const bx=300,bw=360,by=22;
  ctx.fillStyle='rgba(0,0,0,.55)';rr(ctx,bx-6,by-8,bw+12,24,12);ctx.fill();
  ctx.fillStyle='#3b3560';rr(ctx,bx,by,bw,8,4);ctx.fill();
  const pp=clamp(pl.x/cfg.length,0,1),wp=clamp((wolf.x+50)/cfg.length,0,1);
  ctx.fillStyle='#ffd166';rr(ctx,bx,by,Math.max(8,bw*pp),8,4);ctx.fill();
  ctx.fillStyle='#ff4d4d';ctx.beginPath();ctx.arc(bx+bw*wp,by+4,7,0,7);ctx.fill();
  ctx.fillStyle='#4da6ff';ctx.beginPath();ctx.arc(bx+bw*pp,by+4,7,0,7);ctx.fill();
  text('🏁',bx+bw+14,by+5,16,'#fff','left');
  text('Khoảng cách sói: '+Math.max(0,Math.round(gap))+'m',W/2,50,13,gap<dg*.77?'#ff8a8a':'#d8cff5','center','rgba(0,0,0,.6)');
  if(run.banner>0){ctx.globalAlpha=clamp(run.banner,0,1);text('CHẠY!!!',W/2,170,64,'#ff5d8f','center','#1a0a20');
    if(level<=2)text('Giữ → / D để chạy · ↑ / W / Space để nhảy',W/2,225,22,'#fff','center','rgba(0,0,0,.7)');ctx.globalAlpha=1;}
  else if(level<=2&&run.t<8)text('Giữ → / D để chạy · ↑ / W / Space để nhảy',W/2,500,18,'#fff','center','rgba(0,0,0,.7)');
}
const playerSpeedNow=()=>pl?Math.abs(pl.vx):0;
function render(){
  ctx.save();
  if(shake>.3)ctx.translate((Math.random()-.5)*shake,(Math.random()-.5)*shake);
  if((state==='chase'||state==='result')&&LV&&pl)renderChase();else renderSteal();
  ctx.restore();
  drawConfs();
  if(paused){ctx.fillStyle='rgba(0,0,0,.25)';ctx.fillRect(0,0,W,H);}
}

/* =================== VÒNG LẶP CHÍNH =================== */
let last=0,pauseShown=false;
function frame(ts){
  const dt=Math.min(.033,Math.max(0,(ts-last)/1000));last=ts;tNow+=dt;
  if(!paused){
    if(state==='steal'||state==='menu')updSteal(dt);
    else if(state==='chase')updChase(dt);
    updFx(dt);
  }
  const wantBtn=(state==='steal'||state==='chase')&&!paused;
  if(wantBtn!==pauseShown){pauseShown=wantBtn;$('pauseBtn').classList.toggle('on',wantBtn);}
  render();requestAnimationFrame(frame);
}

/* =================== ĐIỀU KHIỂN & NÚT =================== */
window.addEventListener('keydown',e=>{
  const k=e.key.toLowerCase();
  if(['arrowup','arrowdown','arrowleft','arrowright',' '].includes(k)&&(state==='chase'||state==='steal'))e.preventDefault();
  if(k==='escape'||k==='p'){if(!e.repeat)togglePause();return;}
  if(k==='m'){if(!e.repeat){initAudio();setMuted(!muted);}return;}
  if(k==='arrowright'||k==='d')keys.right=true;
  else if(k==='arrowleft'||k==='a')keys.left=true;
  else if(k==='arrowup'||k==='w'||k===' '){if(state==='chase'&&!paused&&pl)pl.jbuf=.12;}
});
window.addEventListener('keyup',e=>{
  const k=e.key.toLowerCase();
  if(k==='arrowright'||k==='d')keys.right=false;
  else if(k==='arrowleft'||k==='a')keys.left=false;
});
window.addEventListener('blur',()=>{keys.left=keys.right=false;if(state==='chase'&&!paused)togglePause();});
document.addEventListener('visibilitychange',()=>{if(document.hidden&&state==='chase'&&!paused)togglePause();});

$('bPlay').addEventListener('click',()=>{SFX.ui();beginLevel(save.unlocked);});
$('bLevels').addEventListener('click',()=>{initAudio();SFX.ui();buildLevels();show('levels');});
$('bShop').addEventListener('click',()=>{initAudio();SFX.ui();shopFrom='menu';renderShop();show('shop');});
$('bHelp').addEventListener('click',()=>{initAudio();SFX.ui();show('help');});
$('bMute').addEventListener('click',()=>{initAudio();setMuted(!muted);SFX.ui();});
$('lvBack').addEventListener('click',()=>{SFX.ui();show('menu');});
$('helpBack').addEventListener('click',()=>{SFX.ui();show('menu');});
$('shopBack').addEventListener('click',()=>{SFX.ui();refreshMenu();if(shopFrom==='result'){show('result');}else show('menu');});
$('pauseBtn').addEventListener('mousedown',e=>e.preventDefault());
$('pauseBtn').addEventListener('click',e=>{e.currentTarget.blur();initAudio();SFX.ui();togglePause();});
$('pResume').addEventListener('click',()=>{SFX.ui();togglePause();});
$('pRetry').addEventListener('click',()=>{SFX.ui();beginLevel(level);});
$('pMenu').addEventListener('click',()=>{SFX.ui();toMenu();});
$('rNext').addEventListener('click',()=>{SFX.ui();beginLevel(Math.min(MAX_LEVEL,level+1));});
$('rRetry').addEventListener('click',()=>{SFX.ui();beginLevel(level);});
$('rShop').addEventListener('click',()=>{SFX.ui();shopFrom='result';renderShop();show('shop');});
$('rMenu').addEventListener('click',()=>{SFX.ui();toMenu();});

loadSave();setMuted(muted);refreshMenu();requestAnimationFrame(frame);
</script>
